{
  "buildCommand": "cd .. && pnpm install --no-frozen-lockfile && pnpm run vercel-build",
  "outputDirectory": "../dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
