# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string-in-production
CORS_ORIGIN=http://localhost:3000

# PostgreSQL — matches docker-compose.yml defaults
DATABASE_URL=postgresql://agroscan_user:secure_password@localhost:5432/agroscan

# Frontend (Vite)
VITE_API_BASE_URL=/api

# Demo seed user password (used by db:setup script only)
SEED_DEMO_PASSWORD=AgroScan@2026

