# FastAPI backend — copy to backend/.env
DATABASE_URL=postgresql+psycopg://agroscan_user:secure_password@localhost:5432/agroscan
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads
USE_MOCK_MODEL=true
API_HOST=0.0.0.0
API_PORT=8000
